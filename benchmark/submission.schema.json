{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "participant", "model_name", "paper_url", "code_url", "source_commit", "checkpoint_url", "checkpoint_sha256", "split_hash", "preprocess", "classes"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
    "participant": {"enum": ["turki", "muhannad", "mazen"]},
    "model_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "paper_url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 1000},
    "code_url": {"type": "string", "pattern": "^https://github\\.com/[^\\s]+$", "maxLength": 1000},
    "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "checkpoint_url": {"type": "string", "pattern": "^https://github\\.com/turkialjutaili/Shuaa/releases/download/[^\\s?#]+\\.onnx$", "maxLength": 1000},
    "checkpoint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "split_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "classes": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "string"}},
    "preprocess": {"type": "object", "additionalProperties": false, "required": ["input_size", "color_mode", "resize", "mean", "std"], "properties": {
      "input_size": {"type": "integer", "minimum": 32, "maximum": 512},
      "color_mode": {"const": "RGB"}, "resize": {"const": "bilinear"},
      "mean": {"const": [0.485, 0.456, 0.406]}, "std": {"const": [0.229, 0.224, 0.225]}
    }}
  }
}
